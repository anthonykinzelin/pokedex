{
  "info": {
    "name": "Pokedex Lot 3 API",
    "description": "Tests the referential and Levels API endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Get M2M token",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{client_id}}", "type": "string" },
            { "key": "password", "value": "{{client_secret}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "grant_type", "value": "client_credentials", "type": "text" },
            { "key": "scope", "value": "{{scope}}", "type": "text" }
          ]
        },
        "url": "{{auth_domain}}/oauth2/token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('token returned', function () {",
              "  pm.response.to.have.status(200);",
              "  const response = pm.response.json();",
              "  pm.expect(response.access_token).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('access_token', response.access_token);",
              "  if (pm.environment.name) pm.environment.set('access_token', response.access_token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Create user",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"username\": \"Postman Trainer\",\n  \"balance\": 100\n}"
        },
        "url": "{{api_base_url}}/users"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const runId = pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('user_id', 'user-' + runId);",
              "pm.collectionVariables.set('pokemon_id', 'pokemon-' + runId);",
              "if (pm.environment.name) {",
              "  pm.environment.set('run_id', runId);",
              "  pm.environment.set('user_id', 'user-' + runId);",
              "  pm.environment.set('pokemon_id', 'pokemon-' + runId);",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('user created', function () {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.json().userId).to.eql(pm.variables.get('user_id'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Add Pokemon",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pokemonId\": \"{{pokemon_id}}\",\n  \"name\": \"Postmanchu\",\n  \"type\": \"electric\",\n  \"price\": 25\n}"
        },
        "url": "{{api_base_url}}/pokemons"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Pokemon created', function () {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.json().pokemonId).to.eql(pm.variables.get('pokemon_id'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - List users",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{api_base_url}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('created user is listed', function () {",
              "  pm.response.to.have.status(200);",
              "  const users = pm.response.json();",
              "  pm.expect(users).to.be.an('array');",
              "  pm.expect(users.some(user => user.userId === pm.variables.get('user_id'))).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5 - List Pokemon",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{api_base_url}}/pokemons"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('created Pokemon is listed', function () {",
              "  pm.response.to.have.status(200);",
              "  const pokemons = pm.response.json();",
              "  pm.expect(pokemons).to.be.an('array');",
              "  pm.expect(pokemons.some(pokemon => pokemon.pokemonId === pm.variables.get('pokemon_id'))).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6 - Purchase Pokemon",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pokemonId\": \"{{pokemon_id}}\"\n}"
        },
        "url": "{{api_base_url}}/users/{{user_id}}/purchases"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('purchase created', function () {",
              "  pm.response.to.have.status(201);",
              "  const purchase = pm.response.json();",
              "  pm.expect(purchase).to.have.property('purchaseId');",
              "  pm.expect(purchase.userId).to.eql(pm.variables.get('user_id'));",
              "  pm.expect(purchase.pokemonId).to.eql(pm.variables.get('pokemon_id'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7 - List users with owned Pokemon",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{api_base_url}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('purchased Pokemon belongs to the user', function () {",
              "  pm.response.to.have.status(200);",
              "  const users = pm.response.json();",
              "  const user = users.find(item => item.userId === pm.variables.get('user_id'));",
              "  pm.expect(user).to.be.an('object');",
              "  pm.expect(user.pokemons).to.be.an('array');",
              "  pm.expect(user.pokemons.some(pokemon => pokemon.pokemonId === pm.variables.get('pokemon_id'))).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8 - Get user level",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{levels_api_base_url}}/users/{{user_id}}/level"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "setTimeout(() => {}, 1000);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const attempts = Number(pm.collectionVariables.get('level_poll_attempts') || 0);",
              "const response = pm.response.code === 200 ? pm.response.json() : {};",
              "const levelIsReady = response.points >= 100 && response.level >= 1;",
              "if (!levelIsReady && attempts < 5) {",
              "  pm.collectionVariables.set('level_poll_attempts', attempts + 1);",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.collectionVariables.unset('level_poll_attempts');",
              "  pm.test('level reflects the purchase', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(response.userId).to.eql(pm.variables.get('user_id'));",
              "    pm.expect(response.points).to.be.at.least(100);",
              "    pm.expect(response.level).to.be.at.least(1);",
              "    pm.expect(response.updatedAt).to.be.a('string').and.not.empty;",
              "  });",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
