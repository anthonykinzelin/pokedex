{
  "info": {
    "name": "Pokedex Lot 3 API",
    "description": "Tests the referential and Levels API endpoints. The server owns the identity of the resources it creates: the client sends a name and gets an id back.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "user_name",
      "value": ""
    },
    {
      "key": "user_name_variant",
      "value": ""
    },
    {
      "key": "pokemon_id",
      "value": ""
    },
    {
      "key": "pokemon_name",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Get M2M token",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{client_id}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{client_secret}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "scope",
              "value": "{{scope}}",
              "type": "text"
            }
          ]
        },
        "url": "{{auth_domain}}/oauth2/token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('token returned', function () {",
              "  pm.response.to.have.status(200);",
              "  const response = pm.response.json();",
              "  pm.expect(response.access_token).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('access_token', response.access_token);",
              "  if (pm.environment.name) pm.environment.set('access_token', response.access_token);",
              "});",
              "",
              "// Names are the uniqueness key now, so each run needs its own. This runs",
              "// once per run because request 1 always runs first.",
              "const runId = pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('user_name', 'Postman Trainer ' + runId);",
              "pm.collectionVariables.set('pokemon_name', 'Postmanchu ' + runId);"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api_base_url}}/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{user_name}}\",\n  \"balance\": 100\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('the server generates the user id', function () {",
              "  pm.response.to.have.status(201);",
              "  const user = pm.response.json();",
              "  // The id comes back from the server: the client never chooses it.",
              "  pm.expect(user.userId).to.match(",
              "    /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/,",
              "  );",
              "  pm.expect(user.name).to.eql(pm.collectionVariables.get('user_name'));",
              "  pm.expect(user.balance).to.eql(100);",
              "  pm.expect(user.pokemons).to.be.an('array').that.is.empty;",
              "  pm.collectionVariables.set('user_id', user.userId);",
              "  if (pm.environment.name) pm.environment.set('user_id', user.userId);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Reject a duplicate user name",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api_base_url}}/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"  {{user_name_variant}}  \"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Upper cased and padded with spaces. The API must still see it as",
              "// the same name, which is what the reservation item guarantees.",
              "const name = pm.collectionVariables.get('user_name');",
              "pm.collectionVariables.set('user_name_variant', name.toUpperCase());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('a duplicate name is rejected and names the existing user', function () {",
              "  pm.response.to.have.status(409);",
              "  const body = pm.response.json();",
              "  pm.expect(body.message).to.be.a('string').and.not.empty;",
              "  pm.expect(body.userId).to.eql(pm.collectionVariables.get('user_id'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Reject a client supplied userId",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api_base_url}}/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"chosen-by-the-client\",\n  \"name\": \"Someone Else\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('a client cannot choose the user id', function () {",
              "  pm.response.to.have.status(400);",
              "  const body = pm.response.json();",
              "  pm.expect(body.field).to.eql('userId');",
              "  pm.expect(body.message).to.include('userId');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5 - Create Pokemon",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api_base_url}}/pokemons",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{pokemon_name}}\",\n  \"type\": \"electric\",\n  \"price\": 25\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('the server derives the pokemon id from the name', function () {",
              "  pm.response.to.have.status(201);",
              "  const pokemon = pm.response.json();",
              "  pm.expect(pokemon.pokemonId).to.be.a('string').and.not.empty;",
              "  // A slug, so it is lower case and has no spaces.",
              "  pm.expect(pokemon.pokemonId).to.eql(pokemon.pokemonId.toLowerCase());",
              "  pm.expect(pokemon.pokemonId).to.not.include(' ');",
              "  pm.collectionVariables.set('pokemon_id', pokemon.pokemonId);",
              "  if (pm.environment.name) pm.environment.set('pokemon_id', pokemon.pokemonId);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6 - List users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{api_base_url}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('the created user is listed, and no reservation item leaks', function () {",
              "  pm.response.to.have.status(200);",
              "  const users = pm.response.json();",
              "  pm.expect(users).to.be.an('array');",
              "  pm.expect(users.some(u => u.userId === pm.collectionVariables.get('user_id'))).to.be.true;",
              "  // Reservation items carry no GSI1 keys, so a sparse index keeps them",
              "  // out of this list. Every row here must be a real user profile.",
              "  users.forEach(u => pm.expect(u.userId).to.be.a('string').and.not.empty);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7 - List Pokemon",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{api_base_url}}/pokemons"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('the created Pokemon is listed', function () {",
              "  pm.response.to.have.status(200);",
              "  const pokemons = pm.response.json();",
              "  pm.expect(pokemons).to.be.an('array');",
              "  pm.expect(pokemons.some(p => p.pokemonId === pm.collectionVariables.get('pokemon_id'))).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8 - Purchase Pokemon",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api_base_url}}/users/{{user_id}}/purchases",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pokemonId\": \"{{pokemon_id}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('purchase created', function () {",
              "  pm.response.to.have.status(201);",
              "  const purchase = pm.response.json();",
              "  pm.expect(purchase).to.have.property('purchaseId');",
              "  pm.expect(purchase.userId).to.eql(pm.collectionVariables.get('user_id'));",
              "  pm.expect(purchase.pokemonId).to.eql(pm.collectionVariables.get('pokemon_id'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9 - List users with owned Pokemon",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{api_base_url}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('the purchased Pokemon belongs to the user', function () {",
              "  pm.response.to.have.status(200);",
              "  const users = pm.response.json();",
              "  const user = users.find(u => u.userId === pm.collectionVariables.get('user_id'));",
              "  pm.expect(user).to.be.an('object');",
              "  pm.expect(user.pokemons).to.be.an('array');",
              "  pm.expect(user.pokemons.some(p => p.pokemonId === pm.collectionVariables.get('pokemon_id'))).to.be.true;",
              "  pm.expect(user.balance).to.eql(75);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Get user level",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{levels_api_base_url}}/users/{{user_id}}/level"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// The purchase reaches Levels through EventBridge and SQS, so the level",
              "// is not there the instant the purchase returns. Poll a few times.",
              "const attempts = Number(pm.collectionVariables.get('level_poll_attempts') || 0);",
              "const response = pm.response.code === 200 ? pm.response.json() : {};",
              "const levelIsReady = response.points >= 100 && response.level >= 1;",
              "if (!levelIsReady && attempts < 5) {",
              "  pm.collectionVariables.set('level_poll_attempts', attempts + 1);",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.collectionVariables.unset('level_poll_attempts');",
              "  pm.test('the level reflects the purchase', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(response.userId).to.eql(pm.collectionVariables.get('user_id'));",
              "    pm.expect(response.points).to.be.at.least(100);",
              "    pm.expect(response.level).to.be.at.least(1);",
              "    pm.expect(response.updatedAt).to.be.a('string').and.not.empty;",
              "  });",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
